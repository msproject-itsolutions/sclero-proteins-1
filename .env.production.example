# =============================================================================
# Sclero Proteins — production environment for docker-compose.
# Copy to ".env" in this directory:  cp .env.production.example .env
# then fill in every CHANGE_ME. This single file feeds both compose (variable
# substitution) and the backend container (env_file).
# =============================================================================

# ---- Compose / shared VPS isolation ----------------------------------------
COMPOSE_PROJECT_NAME=sclero-proteins
APP_IMAGE_TAG=local
# Loopback port consumed by the host nginx. Pick another unused high port if
# 18088 is already assigned to a different project.
SCLERO_HTTP_PORT=18088

# ---- Django core ------------------------------------------------------------
DEBUG=False
# Generate one: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_long_random_secret
INTEGRATION_ENCRYPTION_KEY=CHANGE_ME_stable_fernet_key
# Hosts Django will answer for. "backend" is the internal service name used by
# the Next.js SSR fetches; keep it.
ALLOWED_HOSTS=scleroproteins.co.uk,www.scleroproteins.co.uk,scleroproteins.in,www.scleroproteins.in,scleroproteins.com,www.scleroproteins.com,backend,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://scleroproteins.co.uk,https://www.scleroproteins.co.uk,https://scleroproteins.in,https://www.scleroproteins.in,https://scleroproteins.com,https://www.scleroproteins.com
# Same-origin in production, so CORS is mostly unused; list the live origins anyway.
CORS_ALLOWED_ORIGINS=https://scleroproteins.co.uk,https://scleroproteins.in,https://scleroproteins.com
# Enforce staff RBAC in production.
RBAC_ENFORCED=True
SITE_URL=https://scleroproteins.co.uk
CORS_ALLOW_CREDENTIALS=True
AUTH_COOKIE_MODE=True
ALLOW_SQLITE_FALLBACK=False
ALLOW_SANDBOX_PAYMENTS=False
TRUST_PROXY_HEADERS=True
# Start conservatively. Increase only after every hostname works over HTTPS.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Host nginx owns the public HTTP -> HTTPS redirect. Keep Django's internal
# redirect disabled for Docker health probes and server-side API calls.
SECURE_SSL_REDIRECT=False
DATA_UPLOAD_MAX_MEMORY_SIZE=31457280
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
# Confirm these with finance/legal before launch. They appear on invoices and
# transactional messages.
COMPANY_REGISTRATION_NUMBER=CHANGE_ME_company_number
UK_VAT_NUMBER=CHANGE_ME_vat_number
IN_GSTIN=CHANGE_ME_gstin

# ---- Database (Postgres container) ------------------------------------------
# DB_* are read by Django; POSTGRES_* initialise the postgres container. Keep
# the values in each pair identical.
DB_NAME=sclero_db
DB_USER=sclero
DB_PASSWORD=CHANGE_ME_db_password
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=sclero_db
POSTGRES_USER=sclero
POSTGRES_PASSWORD=CHANGE_ME_db_password

# ---- Frontend (Next.js) -----------------------------------------------------
# Canonical primary host for SEO (sitemap/robots/metadata).
NEXT_PUBLIC_SITE_URL=https://scleroproteins.co.uk
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_MERCHANT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=
NEXT_PUBLIC_IMG_UNOPTIMIZED=false
# Keep false in production. True changes CSP to report-only for diagnostics.
CSP_REPORT_ONLY=false
# Google sign-in. Leave empty to hide the button. Set to your Google OAuth Web
# Client ID to enable "Continue with Google" (see GOOGLE_LOGIN_SETUP.md).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# How the SSR layer reaches Django inside the Docker network — do not change.
API_INTERNAL_URL=http://backend:8000

# ---- Payments (paste live keys from the gateway dashboards) -----------------
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ---- Email / SMTP -----------------------------------------------------------
# All transactional + notification mail is sent as support@scleroproteins.co.uk.
# EMAIL_HOST_PASSWORD is the mailbox password — set it ONLY here on the server,
# never commit it. If the mailbox is hosted on Google Workspace/Gmail, use an
# App Password (Google blocks plain passwords for SMTP): myaccount.google.com
# -> Security -> 2-Step Verification -> App passwords.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=support@scleroproteins.co.uk
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=support@scleroproteins.co.uk
EMAIL_FROM_NAME="Sclero Proteins Support"

# Optional support-inbox ingestion. When enabled, unread messages become CRM
# support tickets. Leave disabled until the mailbox credentials are verified.
IMAP_ENABLED=False
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=support@scleroproteins.co.uk
IMAP_PASSWORD=

# ---- Browser Web Push -------------------------------------------------------
# vps-install.sh generates the private key and public browser key automatically.
VAPID_PRIVATE_KEY=/run/secrets/vapid_private.pem
VAPID_PUBLIC_KEY=CHANGE_ME_generated_by_vps_install
VAPID_SUBJECT=mailto:support@scleroproteins.co.uk

# ---- Geo-IP (optional) ------------------------------------------------------
# With Cloudflare proxying your DNS the CF-IPCountry header is injected for you
# and no MaxMind DB is needed. Without Cloudflare, download GeoLite2-Country.mmdb
# and mount it, then set the in-container path here.
MAXMIND_DB_PATH=
# Optional HTTPS-only fallback provider, including its trailing path separator.
# Leave blank when Cloudflare or the local MaxMind database is enabled.
GEOIP_API_URL=

# ---- Observability (optional) ----------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ---- Container resource budgets -------------------------------------------
DB_MEMORY_LIMIT=768m
BACKEND_MEMORY_LIMIT=768m
SCHEDULER_MEMORY_LIMIT=384m
FRONTEND_MEMORY_LIMIT=768m
EDGE_MEMORY_LIMIT=128m
DB_CPUS=1.0
BACKEND_CPUS=1.0
SCHEDULER_CPUS=0.5
FRONTEND_CPUS=1.0
EDGE_CPUS=0.25
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ---- Scheduled jobs --------------------------------------------------------
SCHEDULE_WEBHOOK_SECONDS=60
SCHEDULE_EMAIL_SYNC_SECONDS=900
SCHEDULE_EMAIL_RETRY_SECONDS=300
SCHEDULE_CART_SECONDS=3600
SCHEDULE_REVIEW_SECONDS=86400
SCHEDULE_PUSH_SECONDS=60
# Daily cleanup of old job history and completed webhook/email queue rows.
SCHEDULE_PRUNE_SECONDS=86400
SCHEDULER_LEASE_SECONDS=300
