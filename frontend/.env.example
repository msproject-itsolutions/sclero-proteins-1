# Backend API base URL (no trailing slash).
# DEV: point at the local Django server.
# PROD: leave EMPTY so the browser calls the API same-origin (nginx proxies /api
#       per ccTLD). Server-side rendering then uses API_INTERNAL_URL instead.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical primary site URL — used by sitemap.xml, robots.txt and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side (SSR) backend URL. Only needed when NEXT_PUBLIC_API_URL is empty
# (production). In Docker this is the internal service name, e.g. http://backend:8000
# API_INTERNAL_URL=

# Google sign-in (optional). When EMPTY, the Google button is hidden and only
# email/password + email-code login show. Set this to your Google OAuth Web
# Client ID (from Google Cloud Console) to enable "Continue with Google".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Analytics (optional)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Stripe publishable key — required for Apple Pay / Google Pay
# (Payment Request Button). When empty, the wallet button silently
# does not render and checkout falls back to card/PayPal/COD only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public legal identifiers shown in the footer. Confirm with finance/legal.
NEXT_PUBLIC_COMPANY_REGISTRATION_NUMBER=
NEXT_PUBLIC_IN_GSTIN=
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=
