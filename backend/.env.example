# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-secure-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,scleroproteins.com,scleroproteins.in,scleroproteins.co.uk

# Staff RBAC enforcement defaults to True in every environment.
RBAC_ENFORCED=True
# Local runserver should not trust client-supplied forwarding headers.
TRUST_PROXY_HEADERS=False

# Seed-time passwords. REQUIRED when DEBUG=False (the seed commands refuse to
# silently set known defaults in production). Pick long random values.
SEED_SUPERUSER_PASSWORD=
SEED_STAFF_PASSWORD=

# Database Settings (local DEBUG may fall back to SQLite; production never does)
DB_NAME=sclero_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payment Gateways (Stripe Sandbox)
STRIPE_PUBLISHABLE_KEY=pk_test_mock_keys_here
STRIPE_SECRET_KEY=sk_test_mock_keys_here
STRIPE_WEBHOOK_SECRET=whsec_mock_keys_here

# Payment Gateways (Razorpay Sandbox)
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_mock_key_secret

# Payment Gateways (PayPal Sandbox)
PAYPAL_CLIENT_ID=paypal_mock_client_id
PAYPAL_CLIENT_SECRET=paypal_mock_client_secret

# SMTP Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=Scleroproteins1
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=support@scleroproteins.co.uk
EMAIL_FROM_NAME="Sclero Proteins Support"
COMPANY_REGISTRATION_NUMBER=
UK_VAT_NUMBER=
IN_GSTIN=24AFXFS9162D1ZG

# Webhook secrets (real values pasted from gateway dashboards once live keys are set)
STRIPE_WEBHOOK_SECRET=whsec_TODO
RAZORPAY_WEBHOOK_SECRET=TODO
PAYPAL_WEBHOOK_ID=TODO

# MaxMind GeoLite2 (OPTIONAL — for geo-IP region detection)
# If unset, geo detection falls back to Cloudflare / Vercel headers only.
# Download GeoLite2-Country.mmdb from
#   https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# and set the absolute path below. The geoip2 package must also be installed
# (geoip2>=4.7.0) — it's a soft dependency, only imported when this is set.
MAXMIND_DB_PATH=

# Stripe publishable key (also referenced by the frontend as
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY). Required for Apple Pay / Google Pay.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_TODO_replace_with_live_key

# Sentry observability (OPTIONAL — leave blank to disable)
# Create a Django project at https://sentry.io and paste the DSN below.
# send_default_pii is forced to False so customer data never leaves the box.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# WhatsApp API Configuration (e.g. Meta Cloud API or Twilio)
WHATSAPP_API_TOKEN=whatsapp_api_token_here
WHATSAPP_PHONE_NUMBER_ID=whatsapp_phone_number_id_here
